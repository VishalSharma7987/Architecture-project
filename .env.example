# Copy this file to `.env` and fill in your keys, then restart the dev server.
#
# These are deliberately NOT prefixed with `VITE_`. Vite only exposes `VITE_*`
# variables to client code, so these keys stay in the Node process that serves
# /api/ai/* and never reach the browser bundle.
#
# `.env` is gitignored; this `.env.example` is committed — so it must only ever
# hold placeholders, never a real key.

# Blueprint detection runs on OpenRouter with a free vision model. It tries
# these keys in turn — a second key covers the free model's per-account rate
# limit. The second is optional; one key is enough to work.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_API_KEY_2=sk-or-...

# Only used by the AI generate/edit features (not blueprint detection). Leave
# unset unless you use those.
ANTHROPIC_API_KEY=
