# Copy this file to `.env` and fill in your keys, then restart the dev server.
#
# `.env` is gitignored; this `.env.example` is committed — so it must only ever
# hold placeholders, never a real key.


# ─── SECRETS ─────────────────────────────────────────────────────────────────
# Deliberately NOT prefixed with `VITE_`. Vite inlines every `VITE_*` variable
# into the client bundle, so a key named that way would be published to every
# visitor. Without the prefix they stay in the Node process that serves
# /api/ai/* and never reach the browser.
#
# `src/ai/endpoint.test.ts` fails the build if either name ever appears in
# `src/`, so this boundary is enforced rather than remembered.

# Every AI feature runs on OpenRouter. Generate/edit use a paid model;
# blueprint detection uses a free vision model, which is rate-limited per
# account — a second key roughly doubles that budget. The second is optional.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_API_KEY_2=

# Unused. `aiPlugin` accepts it for signature stability and discards it —
# generate/edit moved to OpenRouter. Kept documented so nobody spends an
# afternoon working out why setting it changes nothing.
ANTHROPIC_API_KEY=


# ─── BUILD-TIME CONFIGURATION (public — inlined into the bundle) ─────────────
#
# `server/aiPlugin.ts` mounts /api/ai/* from Vite's `configureServer` hook,
# which runs under `npm run dev` and NOWHERE ELSE. `npm run build` emits the
# front end alone, so a deployed build has no AI endpoints unless you have
# stood one up yourself.
#
# Leave this UNSET and the built app disables its AI controls and says why.
# That is the honest default: previously the buttons stayed live, POSTed into
# a 404, and reported "The server returned a malformed response".
#
# Set it to the origin of a service exposing POST /api/ai/generate, /edit and
# /openings — reimplement `server/aiPlugin.ts` behind it and keep the keys
# there, never here. This is an ADDRESS, not a credential; it is safe to
# publish, which is why it may carry the `VITE_` prefix.
#
#   VITE_AI_BASE_URL=https://ai.example.com
VITE_AI_BASE_URL=
